# Copy to .env (`cp env.example .env`). Nothing in .env is committed.

# The transport credential the runtime presents to your domain server
# (Authorization: Bearer ...). Any long random string; the same value goes
# into the registered domain via domains/push_domains.sh.
EVAL_DOMAIN_SHARED_SECRET=change-me-to-a-long-random-string

# Where the hosted runtime reaches your domain server. Printed by
# scripts/tunnel_url.sh after `docker compose up`. Must end in /api.
EVAL_DOMAIN_BASE_URL=https://REPLACE-ME.trycloudflare.com/api

# Your Waxell workspace, for verifying the identity headers offline.
# `wax -p eval axid show` prints both (API host and tenant id).
WAXELL_API_URL=https://api.waxell.dev
WAXELL_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional: your workspace's app URL (https://<your-slug>.waxell.dev). When set,
# the live page at http://localhost:8030/ links every call to its run in the app.
WAXELL_APP_URL=
